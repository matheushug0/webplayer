{
  "meta": {
    "project": "CineVault Streaming",
    "source": "cinevault-streaming-22.aura.build",
    "architecture": "utility-first (Tailwind CSS v3 default theme) — Aura artifact",
    "darkMode": "always dark (no light theme defined)",
    "remBase": "16px"
  },
  "color": {
    "brand": {
      "purple200": "#e9d5ff",
      "purple400": "#a78bfa",
      "purple500": "#a855f7",
      "purple600": "#9333ea",
      "purple900": "#581c87"
    },
    "accent": {
      "red200": "#fecaca",
      "red400": "#f87171",
      "red500": "#ef4444",
      "red600": "#dc2626"
    },
    "info": {
      "sky200": "#bae6fd",
      "sky400": "#38bdf8"
    },
    "neutral": {
      "0": "#ffffff",
      "200": "#e5e5e5",
      "400": "#a3a3a3",
      "600": "#525252",
      "800": "#262626",
      "900": "#171717",
      "1000": "#000000"
    },
    "surface": {
      "glass": "rgba(255,255,255,0.05)",
      "glassHover": "rgba(255,255,255,0.10)",
      "navPill": "rgba(23,23,23,0.60)"
    },
    "text": {
      "primary": "rgba(255,255,255,0.90)",
      "secondary": "rgba(255,255,255,0.80)",
      "body": "rgba(255,255,255,0.70)",
      "muted": "rgba(255,255,255,0.60)",
      "faint": "rgba(255,255,255,0.50)",
      "ghost": "rgba(255,255,255,0.40)"
    },
    "border": {
      "default": "rgba(255,255,255,0.10)",
      "strong": "rgba(255,255,255,0.20)",
      "badgeAlpha": 0.3,
      "badgeBgAlpha": 0.15
    },
    "gradient": {
      "pageBackground": "linear-gradient(to bottom, rgba(88,28,135,0.2), #000000 50%, #000000)",
      "sectionDivider": "linear-gradient(transparent, rgba(139,92,246,0.05), transparent)",
      "ctaPrimary": "linear-gradient(to right, #9333ea, #dc2626)",
      "cardGlowPurple": "radial-gradient(80% 120% at 10% 0%, rgba(139,92,246,0.14) 0%, rgba(0,0,0,0) 55%)",
      "cardGlowRed": "radial-gradient(80% 120% at 90% -10%, rgba(239,68,68,0.16) 0%, rgba(0,0,0,0) 55%)"
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "'Geist', sans-serif",
      "body": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, Cantarell, 'Helvetica Neue', 'Noto Sans', 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', sans-serif"
    },
    "fontSize": {
      "caption": "11px",
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px",
      "6xl": "60px",
      "7xl": "72px",
      "display": "40px"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600
    },
    "lineHeight": {
      "hero": 1,
      "tightCustom": 0.95
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "tighter": "-0.05em"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px",
    "baseStep": "4px"
  },
  "radius": {
    "lg": "8px",
    "xl": "12px",
    "2xl": "16px",
    "full": "9999px",
    "card": "16px",
    "pill": "9999px"
  },
  "shadow": {
    "ctaLayered": "0 2.8px 2.2px rgba(0,0,0,0.3), 0 6.7px 5.3px rgba(0,0,0,0.35), 0 12.5px 10px rgba(0,0,0,0.4)",
    "insetHighlight": "inset 0 1px 0 rgba(255,255,255,0.08)"
  },
  "border": {
    "width": { "default": "1px", "avatarRing": "2px" },
    "style": "solid"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "container": {
    "maxW7xl": "1280px",
    "maxW5xl": "1024px",
    "maxW4xl": "896px",
    "maxW3xl": "768px",
    "maxW2xl": "672px",
    "maxWxl": "576px",
    "maxWmd": "448px",
    "padding": "16px 24px 32px (sm/lg)"
  },
  "grid": {
    "gutterMain": "24px",
    "gutterPartners": "32px",
    "columns": { "mobile": "1", "sm": "3", "md": "2,3,4,6" }
  },
  "motion": {
    "keyframes": {
      "fadeSlideIn": "opacity 0->1; translateY(30px)->0; blur(8px)->0; 1s ease-out; delays 0.1-0.6s",
      "cmsShimmer": "background-position -200%->200%; 1.5s infinite"
    },
    "fast": "150ms",
    "normal": "300ms",
    "slow": "500ms",
    "custom": "1000ms",
    "easing": {
      "out": "ease-out",
      "inOut": "ease-in-out",
      "expo": "cubic-bezier(0.15,0.83,0.66,1)"
    }
  },
  "zIndex": {
    "background": "-10",
    "base": "0",
    "content": "10"
  },
  "icon": {
    "library": "lucide",
    "viewBox": "0 0 24 24",
    "strokeWidth": 2,
    "sizeDefault": "16px",
    "sizeSmall": "14px",
    "sizeMedium": "16px",
    "sizeLarge": "20px",
    "sizeNonScale": "18px"
  },
  "image": {
    "formats": ["webp", "jpg", "png"],
    "aspect": { "video": "16/9", "poster": "4/3" },
    "avatar": { "size": "36px", "ring": "2px rgba(0,0,0,0.6)" }
  },
  "exceptions": [
    "text-[40px] display out of scale",
    "w-4.5/h-4.5 (18px) non-standard spacing",
    "border-radius 12px hardcoded in cms-shimmer",
    "17 font families loaded but unused (only Geist and Inter used)",
    "shadows defined as arbitrary classes, not tokens"
  ]
}